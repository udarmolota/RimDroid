<!-- Outlined (unfilled) circle around the Zomdroid glyph in the drawer footer. Inset ~7dp on
     every side so the ring is ~30dp inside the 44dp button (≈1.5× smaller than the full button)
     and hugs the icon instead of floating far around it. The button stays 44dp for the tap
     target; only the drawn ring shrinks. Matches the other footer icons' tint. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="7dp">
    <shape android:shape="oval">
        <solid android:color="@android:color/transparent"/>
        <stroke
            android:width="1.5dp"
            android:color="?attr/colorOnSurfaceVariant"/>
    </shape>
</inset>
