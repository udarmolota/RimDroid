<?xml version="1.0" encoding="utf-8"?>
<!-- Controls editor toolbar toggle (Grid), ported from ValDroid: outlined like the other toolbar
     buttons, filled orange while checked so "on" reads at a glance. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#CCFFA726" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#40FFFFFF" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#99000000" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
</selector>
