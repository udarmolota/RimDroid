<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#202830">

    <!-- Optional reference image behind the controls: load a game screenshot so buttons can be
         placed against what they'll actually sit on top of. Editor-only, never shown in-game. -->
    <ImageView
        android:id="@+id/editor_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/editor_bg_set" />

    <!-- The on-screen controls (edit mode) are added here programmatically -->
    <FrameLayout
        android:id="@+id/controls_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Toolbar: a compact centred row of separate buttons floating over the layout, so it covers
         as little of it as possible (ported from ValDroid; was a full-width dark band). Explicit
         MaterialButton: this is a plain Activity, so a bare <Button> is not upgraded to one and the
         outlined style would draw as bare text. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add"
            style="@style/AppTheme.EditorToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/AppTheme.EditorToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bg_set"
            style="@style/AppTheme.EditorToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_bg_set" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bg_clear"
            style="@style/AppTheme.EditorToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_bg_clear" />

        <ToggleButton
            android:id="@+id/btn_grid"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/editor_toggle_bg"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textOn="@string/editor_grid_on"
            android:textOff="@string/editor_grid_off" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_done"
            style="@style/AppTheme.EditorToolbarButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_done" />
    </LinearLayout>

    <!-- Per-element settings panel (right side; shown when an element is selected) -->
    <ScrollView
        android:id="@+id/panel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#CC101820"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/panel_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>
</FrameLayout>
