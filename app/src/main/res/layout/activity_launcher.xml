<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LauncherActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rd_page_bg"
        app:liftOnScroll="false"
        android:elevation="0dp"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"/>

        <fragment
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Drawer panel: the menu, then a pinned bottom row of link icons between two divider lines
         (GitHub / X / Reddit / Support), so the four external links don't eat four menu rows.
         Fixed width (not wrap_content): otherwise the full-width icon row / dividers and the
         NavigationView's own default width fight during measure and stretch the panel wider than
         the menu needs. 300dp is the standard drawer width Zomdroid uses too. -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?attr/colorSurface">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/launcher_nv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            app:menu="@menu/drawer_menu"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorPrimary"/>

        <!-- Bottom link row: GitHub / X / Reddit / Donate / Zomdroid. Each is a labelled column of
             equal weight, so the captions decide the spacing and the glyphs are self-explanatory
             (an unlabelled heart read as "favourite", an unlabelled Zomdroid glyph as nothing at
             all). Zomdroid is a cross-promo: same author, sibling launcher for Project Zomboid. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal">

                    <ImageButton
                        android:id="@+id/link_github"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_github"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@string/nav_updates"/>

                    <!-- "update available" dot; shown by refreshUpdateBadge() when GitHub has a newer release -->
                    <View
                        android:id="@+id/update_badge"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/update_badge_dot"
                        android:visibility="gone"/>
                </FrameLayout>

                <TextView
                    style="@style/AppTheme.NavBottomLabel"
                    android:text="@string/nav_label_github"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/link_x"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerInside"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_x"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/link_x"/>

                <TextView
                    style="@style/AppTheme.NavBottomLabel"
                    android:text="@string/nav_label_x"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/link_reddit"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerInside"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_reddit"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/link_reddit"/>

                <TextView
                    style="@style/AppTheme.NavBottomLabel"
                    android:text="@string/nav_label_reddit"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/link_support"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerInside"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_donate"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/nav_label_donate"/>

                <TextView
                    style="@style/AppTheme.NavBottomLabel"
                    android:text="@string/nav_label_donate"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/link_zomdroid"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_circle_zomdroid"
                    android:src="@drawable/ic_zomdroid"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/nav_label_zomdroid"/>

                <TextView
                    style="@style/AppTheme.NavBottomLabel"
                    android:text="@string/nav_label_zomdroid"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorPrimary"/>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>