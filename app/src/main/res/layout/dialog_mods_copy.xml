<?xml version="1.0" encoding="utf-8"?>
<!-- Mods screen, "Copy mods to another instance": the target instance and whether its load order
     follows this one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <ListView
        android:id="@+id/lv_mods_copy_targets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <CheckBox
        android:id="@+id/cb_mods_copy_order"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/mods_copy_order" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:alpha="0.7"
        android:text="@string/mods_copy_order_hint"
        android:textSize="12sp" />
</LinearLayout>
