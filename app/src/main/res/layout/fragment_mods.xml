<?xml version="1.0" encoding="utf-8"?>
<!-- Mods of one instance (ModsFragment): the top card picks the instance and holds the install
     button; below, a search field and one list — "Active" in load order, then "Inactive" by name.
     Text is two sizes smaller than ValDroid's mods screen: a RimWorld list is 50–100 mods long. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/AppTheme.CardHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/install_content_instance" />

            <Spinner
                android:id="@+id/sp_mods_instance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_mods_game_running"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mods_game_running"
                android:textColor="?attr/colorError"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_mods_no_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.7"
                android:text="@string/mods_no_config"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mods_sort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/mods_sort"
                    android:textSize="12sp" />

                <!-- Enable / disable every mod shown (all of them, or what the search leaves):
                     players load 150 mods at once. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mods_enable_all"
                    style="@style/Widget.Material3.Button.IconButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/mods_enable_all"
                    android:tooltipText="@string/mods_enable_all"
                    app:icon="@drawable/ic_mods_enable_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mods_disable_all"
                    style="@style/Widget.Material3.Button.IconButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/mods_disable_all"
                    android:tooltipText="@string/mods_disable_all"
                    app:icon="@drawable/ic_mods_disable_all" />

                <!-- Copy this instance's mods (and, if asked, its load order) into another instance. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mods_copy"
                    style="@style/Widget.Material3.Button.IconButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/mods_copy"
                    android:tooltipText="@string/mods_copy"
                    app:icon="@drawable/ic_mods_copy" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:text="@string/mods_sort_hint"
                android:textSize="12sp" />

            <!-- Installing a zip is a link-style button under the row (as in Zomdroid): Sort and the two
                 select-all icons keep one line on a narrow phone in every language. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mods_install"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="@string/mods_install_zip"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <EditText
        android:id="@+id/et_mods_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:hint="@string/mods_search"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_mods_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.7"
        android:text="@string/mods_empty"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mods"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>
