<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <!-- Faint RimDroid logo piece, flush to the card's top-left corner.
         FIXED size (no match_parent — that inflated the card height). -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:scaleType="fitStart"
        android:alpha="0.16"
        android:src="@drawable/rd_logo_small"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/instance_item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <!--TextView
                android:id="@+id/instance_item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:ellipsize="end"
                android:maxLines="1" /-->
        </LinearLayout>

        <ImageButton
            android:id="@+id/instance_item_settings"
            style="@style/AppTheme.ImageButton"
            android:src="@drawable/mt_icon_settings"
            android:contentDescription="@string/nav_settings" />

        <ImageButton
            android:id="@+id/instance_item_launch"
            style="@style/AppTheme.ImageButton"
            android:layout_marginStart="4dp"
            android:src="@drawable/mt_icon_play"
            android:tint="?attr/colorPrimary"
            android:contentDescription="@string/launch" />
    </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
