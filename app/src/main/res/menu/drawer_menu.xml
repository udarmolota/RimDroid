<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1) Set up an instance: add it, pick a GPU driver, install mods/DLC -->
    <group android:id="@+id/group_game" android:checkableBehavior="none">
        <item
            android:id="@+id/action_install_instance"
            android:icon="@drawable/mt_icon_add"
            android:title="@string/nav_new_instance" />
        <item
            android:id="@+id/action_custom_driver"
            android:icon="@drawable/mt_icon_settings"
            android:title="@string/nav_custom_driver" />
        <item
            android:id="@+id/action_mods"
            android:icon="@drawable/mt_icon_mods"
            android:title="@string/nav_mods" />
        <item
            android:id="@+id/action_install_content"
            android:icon="@drawable/mt_icon_mods"
            android:title="@string/nav_install_content" />
    </group>

    <!-- 2) On-screen controls: the editor, button icons and layout import/export in one place
         (as ValDroid). The editor asks which instance when there are several. -->
    <group android:id="@+id/group_controls" android:checkableBehavior="none">
        <item
            android:id="@+id/action_edit_controls"
            android:icon="@drawable/mt_icon_tune"
            android:title="@string/edit_controls" />
        <item
            android:id="@+id/action_icon_packs"
            android:icon="@drawable/mt_icon_stack"
            android:title="@string/nav_icon_packs" />
        <item
            android:id="@+id/action_controls_transfer"
            android:icon="@drawable/mt_icon_folder_open"
            android:title="@string/nav_controls_transfer" />
    </group>

    <!-- 3) Get the game from a store you own it on (Steam, GOG) -->
    <group android:id="@+id/group_store" android:checkableBehavior="none">
        <item
            android:id="@+id/action_download_game"
            android:icon="@drawable/ic_steam"
            android:title="@string/nav_download_game" />
        <item
            android:id="@+id/action_open_workshop"
            android:icon="@drawable/ic_steam"
            android:title="@string/workshop_menu" />
        <item
            android:id="@+id/action_cloud_saves"
            android:icon="@drawable/mt_icon_save"
            android:title="@string/nav_cloud_saves" />
        <item
            android:id="@+id/action_gog_login"
            android:icon="@drawable/ic_gog"
            android:title="@string/nav_gog_login" />
    </group>

    <!-- 4) Settings + data transfer (saves / settings) -->
    <group android:id="@+id/group_data" android:checkableBehavior="none">
        <item
            android:id="@+id/action_settings"
            android:icon="@drawable/mt_icon_settings"
            android:title="@string/nav_settings" />
        <item
            android:id="@+id/action_saves_transfer"
            android:icon="@drawable/mt_icon_save"
            android:title="@string/nav_saves_transfer" />
        <item
            android:id="@+id/action_settings_transfer"
            android:icon="@drawable/mt_icon_folder_open"
            android:title="@string/nav_settings_transfer" />
    </group>

    <!-- 5) Diagnostics -->
    <group android:id="@+id/group_files" android:checkableBehavior="none">
        <!-- "Manage storage" lives on each instance card's own menu (menu_game_instance.xml), where
             it acts on that instance — a global duplicate only made this drawer longer. -->
        <item
            android:id="@+id/action_bug_report"
            android:icon="@drawable/ic_bug_report"
            android:title="@string/nav_bug_report" />
    </group>

    <!-- The four external links (GitHub / X / Reddit / Support) are a row of icons in the drawer
         HEADER (nav_header_links.xml), not menu rows, to keep this list short. -->

</menu>
