<?xml version="1.0" encoding="utf-8"?>
<!-- Portuguese. Worded for Brazil (the overwhelming majority of the lusophone audience): "tela",
     "arquivo", "celular", "driver". Deliberately placed in values-pt rather than values-pt-rBR so
     Portugal gets Portuguese too instead of falling back to English — the pt-PT wording differences
     (ecrã / ficheiro / telemóvel) are readable, English is not.
     RimWorld's own pt-BR translation calls pawns "colonos" — keep that so the wording matches the game. -->
