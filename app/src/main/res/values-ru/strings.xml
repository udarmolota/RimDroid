    <!-- Экран загрузки -->
    <string name="download_game_title">Загрузка RimWorld из Steam</string>
    <string name="download_version_note">RimDroid сейчас поддерживает RimWorld 1.5. (В Steam актуальна уже 1.6.) Загружает Linux-сборку прямо в новый инстанс — без Termux и без ПК.</string>
    <string name="download_instance_hint">Имя инстанса (например, RimWorld 1.5)</string>
    <string name="download_version_label">Версия игры</string>
    <string name="download_version_15">RimWorld 1.5</string>
    <string name="download_version_16">RimWorld 1.6</string>
    <string name="download_user_hint">Логин Steam</string>
    <string name="download_pass_hint">Пароль Steam</string>
    <string name="download_login_note">Логин отправляется в Steam (так же, как это делает DepotDownloader) и НЕ сохраняется. Подтвердите вход в приложении Steam Mobile или введите код Steam Guard, когда попросят.</string>
    <string name="download_manifest_hint">Дополнительно: Manifest ID — пусто = рекомендуемая 1.5</string>
    <string name="download_start">Загрузить</string>
    <string name="download_tab_game">Игра</string>
    <string name="download_tab_dlc">DLC</string>
    <string name="download_tab_mods">Моды</string>
    <string name="download_dlc_note">Выберите DLC, которыми владеет ваш аккаунт. Каждое скачивается портативным .zip в /Download/RimDroid — затем импортируйте его в любой инстанс из меню. (Чужие DLC пропускаются.)</string>
    <string name="download_dlc_start">Скачать выбранные DLC</string>
    <string name="download_install_content">Установить мод / DLC в инстанс…</string>
    <string name="download_mods_note">Скачивание модов Мастерской по ID (число в URL мастерской: …/sharedfiles/filedetails/?id=ЧИСЛО). Логин Steam не нужен. Несколько ID — через пробел. Каждый сохраняется в .zip в /Download/RimDroid.</string>
    <string name="download_mods_hint">ID Мастерской — через пробел</string>
    <string name="download_mods_hint_single">ID Мастерской</string>
