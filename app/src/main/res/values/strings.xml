    <string name="cloud_saves_title">Steam Cloud saves</string>
    <string name="cloud_saves_hint">If you also play RimWorld on a PC through Steam, your saves are synced to Steam Cloud — this pulls them onto the phone.\n\nSigning in is confirmed through the Steam Mobile app: you must have signed into it at least once and turned Steam Guard on there. When you tap the button, Steam sends an approval request to that app. The password goes straight to Steam and is never stored here.</string>
    <string name="cloud_saves_user">Steam username</string>
    <string name="cloud_saves_pass">Steam password</string>
    <string name="cloud_saves_instance">Copy the saves into</string>
    <string name="cloud_saves_pull">Get saves from Steam Cloud</string>
    <string name="cloud_saves_push">Send saves to Steam Cloud</string>
    <string name="cloud_saves_pull_note">Everything in your cloud is downloaded first, then copied into this instance. If a save of the same name is already here, you get to choose which one to keep.</string>
    <string name="cloud_saves_push_note">Saves the cloud does not have yet are sent straight away. Anything that would replace a save already up there is listed first, so you can decide. Close the game before sending.</string>
