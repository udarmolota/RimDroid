    <string name="download_version_15">RimWorld 1.5</string>
    <string name="download_version_16">RimWorld 1.6</string>
    <string name="download_user_hint">Steam username</string>
    <string name="download_pass_hint">Steam password</string>
    <string name="download_login_note">Your login is sent to Steam (the same way DepotDownloader works) and is NOT stored. Approve the sign-in in your Steam Mobile app, or enter the Steam Guard code when asked.</string>
    <string name="download_manifest_hint">Advanced: Manifest ID — blank = recommended 1.5</string>
